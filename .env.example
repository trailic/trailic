# Postgres. Raw events are partitioned by month, so the role needs to create tables.
TRAILIC_DATABASE_URL=postgres://user:password@localhost:5432/trailic
# The direct address, for migrations, when TRAILIC_DATABASE_URL goes through a pooler that refuses session settings. Optional.
TRAILIC_DATABASE_URL_UNPOOLED=
# openssl rand -base64 32. Signs sessions: changing it signs everyone out.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# An address of its own for the collector, so that a site's pages don't name the instance. Only /api/e answers there.
TRAILIC_COLLECTOR_URL=
# openssl rand -base64 32. Signs site keys and derives each day's visitor salt. Changing it ends every site key in every project, so keep it safe.
TRAILIC_SECRET=
# Who may sign up and start workspaces, comma-separated. Anyone else needs an invitation, and can only join.
TRAILIC_ADMINS=
# Where events wait for the database: vercel-queue, or file for a server with a disk. Left blank: vercel-queue on Vercel, file elsewhere.
TRAILIC_BUFFER=
# The folder for the file buffer.
TRAILIC_BUFFER_DIR=.trailic-buffer
# The region for Vercel Queues. Messages can only be read from the region they were sent to.
TRAILIC_QUEUE_REGION=fra1
# Addresses and passwords, unless a company's provider is set. Needs RESEND_API_KEY: a mailed link proves each address.
TRAILIC_PASSWORD_SIGN_IN=false
# A company's own identity provider (any OpenID Connect server). When set, members sign in there and nowhere else.
# Redirect address to register with it: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Its name on the sign-in page.
OIDC_NAME=
# Google's OAuth app, for signing in unless a company's provider is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The instance's own mail to its members (sign-in links, invitations), through Resend.
RESEND_API_KEY=
TRAILIC_MAIL_FROM=Trailic <no-reply@example.com>
# What the jobs at /api/cron/flush and /api/cron/retention must be called with, as a bearer.
CRON_SECRET=
