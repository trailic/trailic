{
  "name": "trailic",
  "version": "0.1.1",
  "description": "What people do on your Next.js site: page views and events, with no cookies before identify.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./vitals": { "types": "./dist/vitals.d.ts", "default": "./dist/vitals.js" },
    "./opt-out": { "types": "./dist/opt-out.d.ts", "default": "./dist/opt-out.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
